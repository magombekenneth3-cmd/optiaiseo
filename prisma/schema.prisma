model GrowthDecision {
  id                    String    @id @default(cuid())
  siteId                String
  url                   String
  primaryKeyword        String
  primaryCategory       String
  opportunityCategories Json
  action                String
  score                 Json
  whyNow                Json
  impact                Json
  executionPlan         Json
  status                String    @default("ACTIVE")
  opportunityStatus     String    @default("OPEN") // Phase B lifecycle: OPEN → PROPOSED → APPROVED → EXECUTING → VERIFYING → VERIFIED
  engineVersion         String    @default("v2")

  
  maxProposalRetries    Int       @default(3)
  proposalRetryCount    Int       @default(0) // Current count of retry proposals created
  fingerprint           String?   // Stable identity: sha256(siteId + category + resourceType + resourceId + action)
  inputPeriodStart      DateTime?
  inputPeriodEnd        DateTime?
  generatedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Approval metadata (populated when a human approves this decision)
  approvedBy            String?
  approvedAt            DateTime?
  approvalExpiresAt     DateTime?
  mutationHash          String?   // SHA-256 of the canonical executable mutation

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  experiment Experiment?
  sourceFindings OpportunityFinding[]
  proposals      ActionProposal[]
  scoreRecords   OpportunityScoreRecord[]

  // D.1: Discovery provenance (summary metadata — not source of truth)
  // Source of truth for multi-source provenance is:
  //   OpportunityFinding → AgentFinding → FindingEvidence chain
  primaryDiscoverySource  String?    // Summary: which source first found this ("GSC"|"AUDIT"|"CONTENT"|...)
  discoveredAt            DateTime?  // When this opportunity was first discovered
  lastRefreshedAt         DateTime?  // Last time any source refreshed evidence for this
  expiresAt               DateTime?  // Aggregate: earliest expiry across all evidence sources
  discoveryConfidence     Float?     // 0.0–1.0: probability the observed SEO condition EXISTS (not impact)

  // D.2: Scoring metadata (summary — source of truth is OpportunityScoreRecord)
  lastScoredAt            DateTime?  // When last scored by D.2
  scoringVersion          String?    // Version of the scoring engine that last scored this

  @@unique([siteId, url, primaryKeyword, action])
  @@index([siteId, status])
  @@index([siteId, opportunityStatus])
  @@index([siteId, generatedAt(sort: Desc)])
  @@index([siteId, fingerprint])
  @@index([siteId, expiresAt])
  @@index([siteId, opportunityStatus, expiresAt])
}

// D.2: Durable scoring record — every scoring decision is persisted
// Answers: "Why was this opportunity promoted/deferred/rejected at this time?"
model OpportunityScoreRecord {
  id                   String   @id @default(cuid())
  opportunityId        String
  scoringVersion       String   // "d2-v1", "d2-v2", etc.

  // Score components (all 0–100)
  impactScore          Float    // Expected SEO upside
  confidenceScore      Float    // Confidence that acting produces predicted benefit
  evidenceScore        Float    // Quality/quantity/freshness of evidence
  urgencyScore         Float    // Time sensitivity
  effortScore          Float    // Expected implementation cost
  riskScore            Float    // Downside / uncertainty

  finalScore           Float    // Weighted composite

  decision             String   // "PROMOTE" | "DEFER" | "REJECT"
  decisionReasons      Json     // [{ rule: string, details: string }]

  // Evidence fencing
  evidenceHash         String   // sha256 of canonicalized evidence at scoring time
  evidenceVerifiedAt   DateTime? // Set when evidence re-verified before promotion

  // Weights used (for reproducibility)
  weightsUsed          Json     // { impact: 0.30, confidence: 0.20, ... }

  scoredAt             DateTime @default(now())

  opportunity          GrowthDecision @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, scoredAt(sort: Desc)])
  @@index([decision, scoredAt])
}

