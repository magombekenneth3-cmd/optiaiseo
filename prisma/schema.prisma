
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  REOPENED
  IGNORED
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("inactive")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id              String    @id @default(cuid())
  idempotencyKey  String
  userId          String
  requestPath     String    @default("")
  requestChecksum String
  status          String    @default("PROCESSING")
  responseCode    Int?
  responseBody    Json?
  expiresAt       DateTime  @default(dbgenerated("(now() + '24:00:00'::interval)"))
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey, userId])
  @@index([expiresAt])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  status          String    @default("RECEIVED")
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                     String                   @id @default(cuid())
  name                   String?
  email                  String?                  @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  role                   Role                     @default(USER)
  subscriptionTier       String                   @default("FREE")
  trialEndsAt            DateTime?
  preferences            Json?
  whiteLabel             Json?
  gscConnected           Boolean                  @default(false)
  onboardingDone         Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  accounts               Account[]
  idempotencyKeys        IdempotencyKey[]
  sessions               Session[]
  sites                  Site[]
  viewableSites          Site[]                   @relation("SiteViewers")
  subscription           Subscription?
  passwordResetTokens    PasswordResetToken[]
  teamMemberships        TeamMember[]             @relation("TeamMemberUser")
  ownedTeamMembers       TeamMember[]             @relation("TeamMemberOwner")
  teamInvitations        TeamInvitation[]
  competitorPageAnalyses CompetitorPageAnalysis[]
  strategyMemories       StrategyMemory[]
  referral               Referral?                @relation("ReferralOwner")
  wonReferral            Referral?                @relation("ReferralWinner", fields: [referralId], references: [id])
  referralId             String?
  commissions            Commission[]
  embedLeads             EmbedLead[]
  credits                Int                      @default(50)
  creditsLockedAt        DateTime?
  voiceSessions          VoiceSession[]
  wpApiKey               String?                  @unique
  apiKeys                ApiKey[]
  dripSequence           DripSequence?
  creditHistory          CreditHistory[]
  creditLedger           CreditLedger[]
  notifications          Notification[]
  dailyBriefings         DailyBriefing[]
  campaigns              Campaign[]

  @@index([wpApiKey])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id                      String                   @id @default(cuid())
  userId                  String
  viewerId                String?
  domain                  String
  brandName               String?
  targetKeyword           String?
  operatingMode           String                   @default("REPORT_ONLY")
  githubRepoUrl           String?
  mediumToken             String?
  hashnodeToken           String?
  hashnodePublicationId   String?
  coreServices            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  blogTone                String?                  @default("Authoritative & Professional")
  techStack               String?                  @default("nextjs")
  authorName              String?
  authorRole              String?
  authorBio               String?
  realExperience          String?
  realNumbers             String?
  localContext            String?
  plannerState            Json?
  niche                   String?
  location                String?
  targetCustomer          String?
  wordPressConfig         Json?
  ghostConfig             Json?
  hideFromLeaderboard     Boolean                  @default(false)
  shareToken              String?                  @unique
  slackWebhookUrl         String?
  zapierWebhookUrl        String?
  aeoEvents               AeoEvent[]
  aeoReports              AeoReport[]
  ahrefsSnapshots         AhrefsSnapshot[]
  audits                  Audit[]
  backlinkAlerts          BacklinkAlert[]
  blogs                   Blog[]
  competitors             Competitor[]
  onPageReports           OnPageReport[]
  rankSnapshots           RankSnapshot[]
  selfHealingLogs         SelfHealingLog[]
  aiShareOfVoice          AiShareOfVoice[]
  indexingLogs            IndexingLog[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewer                  User?                    @relation("SiteViewers", fields: [viewerId], references: [id])
  brandFacts              BrandFact[]
  aeoSnapshots            AeoSnapshot[]
  plannerItems            PlannerItem[]
  seedKeywords            SeedKeyword[]
  competitorPageAnalyses  CompetitorPageAnalysis[]
  strategyMemories        StrategyMemory[]
  metricSnapshots         MetricSnapshot[]
  backlinkDetails         BacklinkDetail[]
  healingOutcomes         HealingOutcome[]
  serpFeatures            SerpFeature[]
  serpFeatureSnapshots    SerpFeatureSnapshot[]
  uptimeAlerts            UptimeAlert[]
  voiceSessions           VoiceSession[]
  detectedServices        DetectedService[]
  skippedCompetitors      SkippedCompetitor[]
  indexNowConfig          IndexNowConfig?
  pageAudits              PageAudit[]
  repurposedResults       RepurposedResult[]
  aeoAutopilotEnabled     Boolean                  @default(false)
  aeoAutopilotSchedule    String                   @default("weekly")
  rssFeedUrl              String?
  socialRepurposeEnabled  Boolean                  @default(false)
  socialRepurposeSchedule String                   @default("weekly")
  rssSocialPosts          RssSocialPost[]
  aeoPublicToken          String?                  @unique
  aeoDigestEnabled        Boolean                  @default(true)
  aeoProofs               AeoProof[]
  trackedKeywords         TrackedKeyword[]
  trackedQueries          TrackedQuery[]
  visibilitySnapshots     VisibilitySnapshot[]
  healingPlans            HealingPlan[]
  mentionCorrectionLogs   MentionCorrectionLog[]
  serpGapAnalyses         SerpGapAnalysis[]
  keywordSerpAnalyses     KeywordSerpAnalysis[]
  dailyBriefings          DailyBriefing[]
  competitorAlerts        CompetitorAlert[]
  campaigns               Campaign[]
  growthDecisions         GrowthDecision[]
  experiments             Experiment[]
  competitorAlertLogs     CompetitorAlertLog[]
  evidenceSnapshots       EvidenceSnapshot[]
  gscPerformance          GscDailyPerformance[]
  mutationOperations      MutationOperation[]
  agentRuns               AgentRun[]
  ga4DailyPerformance     Ga4DailyPerformance[]
  actionProposals         ActionProposal[]
  actionPerformances      ActionPerformance[]
  learnedSignals          LearnedSignal[]
  portfolioAllocations    PortfolioAllocation[]

  ga4PropertyId String?

  marketCategoryId String?
  marketCategory   MarketCategory? @relation(fields: [marketCategoryId], references: [id])

  pseoTemplates PseoTemplate[]
  pseoPages     PseoPage[]

  automationsPaused     Boolean @default(false)

  effectCmsEnabled      Boolean @default(true)
  effectGithubEnabled   Boolean @default(true)
  effectIndexNowEnabled Boolean @default(true)

  dailyMutationLimit      Int      @default(10)
  maxConcurrentExecutions Int      @default(2)

  budgetReservations          BudgetReservation[]
  circuitBreakers             CircuitBreaker[]
  autonomousExecutionClaims   AutonomousExecutionClaim[]
  executionTraces             ExecutionTrace[]

  @@index([userId])
  @@index([niche, operatingMode])
}

model BrandFact {
  id        String   @id @default(cuid())
  siteId    String
  factType  String
  value     String
  sourceUrl String?
  verified  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, factType, value])
  @@index([siteId])
}

model AhrefsSnapshot {
  id               String   @id @default(cuid())
  siteId           String
  domainRating     Float?
  organicTraffic   Int?
  backlinks        Int?
  referringDomains Int?
  topKeywords      Json?
  backlinkDomains  Json?
  fetchedAt        DateTime @default(now())
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, fetchedAt(sort: Desc)])
}

model RankSnapshot {
  id           String          @id @default(cuid())
  siteId       String
  keyword      String
  intent       String?
  position     Int
  url          String?
  device       String          @default("desktop")
  searchVolume Int?
  cpc          Float?
  difficulty   Int?
  trackedId    String?
  recordedAt   DateTime        @default(now())
  serpFeatures SerpFeature[]
  site         Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tracked      TrackedKeyword? @relation(fields: [trackedId], references: [id], onDelete: SetNull)

  @@index([siteId, keyword])
  @@index([recordedAt])
  @@index([siteId, keyword, recordedAt(sort: Desc)])
  @@index([trackedId, recordedAt(sort: Desc)])
  @@index([siteId, keyword, device, recordedAt(sort: Desc)])
}

model TrackedKeyword {
  id           String         @id @default(cuid())
  siteId       String
  keyword      String
  locationCode Int            @default(2840)
  device       String         @default("desktop")
  addedAt      DateTime       @default(now())
  addedBy      String
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  snapshots    RankSnapshot[]

  @@unique([siteId, keyword, device])
  @@index([siteId])
}

model AiShareOfVoice {
  id                   String   @id @default(cuid())
  siteId               String
  keyword              String
  modelName            String
  brandMentioned       Boolean  @default(false)
  competitorsMentioned String[] @default([])
  recordedAt           DateTime @default(now())
  gapReason            String?
  gapExplanation       String?
  gapFix               String?
  embeddingGapSignals  String[] @default([])
  mentionConfidence    Float?
  site                 Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, keyword])
  @@index([recordedAt])
  @@index([siteId, mentionConfidence])
  @@index([siteId, modelName, recordedAt(sort: Desc)])
}

model MentionCorrectionLog {
  id           String   @id @default(cuid())
  siteId       String
  keyword      String
  modelName    String
  correctValue Boolean
  rawSnippet   String?
  flaggedAt    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, flaggedAt])
}

model BacklinkAlert {
  id         String   @id @default(cuid())
  siteId     String
  type       String
  domain     String
  url        String   @default("")
  dr         Float?
  detectedAt DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, domain, type])
  @@index([siteId, detectedAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  dismissed Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
}

model OnPageReport {
  id        String   @id @default(cuid())
  siteId    String
  url       String
  issues    Json
  score     Int
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
}

model Audit {
  id             String       @id @default(cuid())
  siteId         String
  categoryScores Json
  issueList      Json
  fixStatus      String       @default("PENDING")
  totalPages     Int          @default(0)
  completedPages Int          @default(0)
  failedPages    Int          @default(0)
  deletedAt      DateTime?
  lcp            Float?
  cls            Float?
  inp            Float?
  runTimestamp   DateTime     @default(now())
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageAudits     PageAudit[]
  shares         AuditShare[]

  @@index([siteId, runTimestamp])
  @@index([siteId, fixStatus, runTimestamp(sort: Desc)])
}

model AuditShare {
  id        String   @id @default(cuid())
  token     String   @unique
  auditId   String
  createdAt DateTime @default(now())
  expiresAt DateTime
  viewCount Int      @default(0)
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([token])
}

model RepurposedResult {
  id          String     @id @default(cuid())
  blogId      String     @unique
  siteId      String
  pageAuditId String?
  data        Json
  status      String     @default("completed")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  blog        Blog       @relation(fields: [blogId], references: [id], onDelete: Cascade)
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageAudit   PageAudit? @relation(fields: [pageAuditId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([pageAuditId])
}

model PageAudit {
  id                String             @id @default(cuid())
  auditId           String
  siteId            String
  pageUrl           String
  overallScore      Int                @default(0)
  categoryScores    Json               @default("{}")
  issueList         Json               @default("[]")
  runTimestamp      DateTime           @default(now())
  audit             Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  repurposedResults RepurposedResult[]

  @@unique([auditId, pageUrl])
  @@index([auditId])
  @@index([siteId, runTimestamp(sort: Desc)])
}

model Blog {
  id                   String            @id @default(cuid())
  siteId               String
  pipelineType         String
  title                String
  slug                 String
  content              String
  metaDescription      String?
  status               String            @default("DRAFT")
  isEditorial          Boolean           @default(false)
  deletedAt            DateTime?
  targetKeywords       String[]
  hashnodeUrl          String?
  mediumUrl            String?
  wordPressUrl         String?
  ghostUrl             String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  publishedAt          DateTime?
  ogImage              String?
  needsRefresh         Boolean           @default(false)
  interactiveWidget    String?
  schemaMarkup         String?
  sourceUrl            String?
  validationScore      Int?
  validationErrors     String[]          @default([])
  validationWarnings   String[]          @default([])
  factCheckIssues      String[]          @default([])
  factCheckSuggestions String[]          @default([])
  citationScore        Int?
  citationCriteria     Json?
  aeoEvents            AeoEvent[]
  repurposedResult     RepurposedResult?
  sourceLinks          InternalLink[]    @relation("SourceLinks")
  targetLinks          InternalLink[]    @relation("TargetLinks")
  site                 Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  version              Int               @default(1)

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([siteId, status, createdAt])
  @@index([siteId, pipelineType, createdAt])
  @@index([siteId, status, publishedAt])
}

model InternalLink {
  id           String   @id @default(cuid())
  siteId       String
  sourceBlogId String
  targetBlogId String
  sourceUrl    String
  targetUrl    String
  anchorText   String?
  createdAt    DateTime @default(now())

  sourceBlog Blog @relation("SourceLinks", fields: [sourceBlogId], references: [id], onDelete: Cascade)
  targetBlog Blog @relation("TargetLinks", fields: [targetBlogId], references: [id], onDelete: Cascade)

  @@unique([sourceBlogId, targetBlogId])
  @@index([siteId, targetUrl])
  @@index([siteId, sourceUrl])
}

model TrendingTopic {
  id        String   @id @default(cuid())
  country   String
  industry  String
  keywords  String[]
  newsData  Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("now() + interval '30 days'"))

  @@index([fetchedAt(sort: Desc)])
  @@index([expiresAt])
}

model MarketCategory {
  id          String       @id @default(cuid())
  category    String
  subcategory String
  geo         String
  audience    String[]     @default([])
  features    String[]     @default([])
  sites       Site[]
  competitors Competitor[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([subcategory, geo])
}

model Competitor {
  id                        String                      @id @default(cuid())
  siteId                    String?
  marketCategoryId          String?
  serviceId                 String?
  domain                    String
  name                      String?
  score                     Float?
  metadata                  Json?
  deletedAt                 DateTime?
  addedAt                   DateTime                    @default(now())
  site                      Site?                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  marketCategory            MarketCategory?             @relation(fields: [marketCategoryId], references: [id])
  service                   DetectedService?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  keywords                  CompetitorKeyword[]
  snapshots                 CompetitorTrafficSnapshot[]
  competitorAhrefsSnapshots CompetitorAhrefsSnapshot[]

  @@unique([siteId, domain])
  @@index([marketCategoryId])
}

model CompetitorAhrefsSnapshot {
  id               String     @id @default(cuid())
  competitorId     String
  domainRating     Float?
  organicTraffic   Int?
  backlinks        Int?
  referringDomains Int?
  createdAt        DateTime   @default(now())
  competitor       Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([competitorId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model DetectedService {
  id                 String              @id @default(cuid())
  siteId             String
  name               String
  label              String
  createdAt          DateTime            @default(now())
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  competitors        Competitor[]
  skippedCompetitors SkippedCompetitor[]

  @@unique([siteId, name])
  @@index([siteId])
}

model CompetitorKeyword {
  id           String     @id @default(cuid())
  competitorId String
  keyword      String
  position     Int?
  searchVolume Int?
  difficulty   Int?
  url          String?
  clicks       Int?
  impressions  Int?
  ctr          Float?
  dataSource   String?
  fetchedAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([competitorId, fetchedAt(sort: Desc)])
}

model CompetitorTrafficSnapshot {
  id              String     @id @default(cuid())
  competitorId    String
  month           String
  estimatedVisits Int
  organicKeywords Int?
  dataSource      String?
  createdAt       DateTime   @default(now())
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, month])
  @@index([competitorId, month])
}

model AeoSnapshot {
  id                     String   @id @default(cuid())
  siteId                 String
  score                  Int
  grade                  String
  citationScore          Int
  generativeShareOfVoice Int
  citationLikelihood     Int
  perplexityScore        Int
  chatgptScore           Int
  claudeScore            Int
  googleAioScore         Int
  grokScore              Int      @default(0)
  copilotScore           Int      @default(0)
  platformBreakdown      Json
  failedChecks           Json
  createdAt              DateTime @default(now())
  site                   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, createdAt])
  @@index([siteId])
  @@index([siteId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model AeoReport {
  id                     String     @id @default(cuid())
  siteId                 String
  status                 String     @default("COMPLETED")
  score                  Int
  grade                  String
  citationScore          Int        @default(0)
  schemaTypes            String[]
  checks                 Json
  topRecommendations     String[]
  createdAt              DateTime   @default(now())
  citationLikelihood     Int        @default(0)
  generativeShareOfVoice Int        @default(0)
  multiEngineScore       Json?
  multiModelResults      Json?
  layerScores            Json?
  diagnosis              Json?
  site                   Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  proofs                 AeoProof[]

  @@index([siteId])
  @@index([siteId, status, createdAt(sort: Desc)])
  @@index([createdAt])
}

model SelfHealingLog {
  id          String   @id @default(cuid())
  siteId      String
  issueType   String
  description String
  actionTaken String
  impactScore Int?
  status      String   @default("COMPLETED")
  metadata    Json?
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([createdAt])
  @@index([siteId, status, createdAt])
}

model CompetitorAlertLog {
  id         String   @id @default(cuid())
  siteId     String
  competitor String
  keyword    String
  delta      Int
  oldPos     Int
  newPos     Int
  sentAt     DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, competitor, keyword, newPos])
  @@index([siteId, sentAt])
}

model AeoEvent {
  id        String   @id @default(cuid())
  siteId    String
  blogId    String?
  eventType String
  intent    String?
  revenue   Float?
  metadata  Json?
  createdAt DateTime @default(now())
  blog      Blog?    @relation(fields: [blogId], references: [id])
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([createdAt])
  @@index([siteId, createdAt(sort: Desc)])
}

model AeoProof {
  id           String     @id @default(cuid())
  siteId       String
  reportId     String?
  query        String
  responseText String     @db.Text
  cited        Boolean    @default(false)
  shareToken   String     @unique @default(cuid())
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  report       AeoReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt(sort: Desc)])
  @@index([shareToken])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]  @default(["aeo:read"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  AGENCY_ADMIN
  EDITOR
  CLIENT_VIEWER
  SUPER_ADMIN
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  ownerId   String
  role      String   @default("VIEWER")
