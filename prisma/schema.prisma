  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages     PseoPage[]

  @@index([siteId, createdAt(sort: Desc)])
}

model PseoPage {
  id              String       @id @default(cuid())
  templateId      String
  siteId          String
  slug            String
  title           String
  metaDescription String?
  contentHtml     String       @db.Text
  schemaJsonLd    Json         @default("[]")
  heroVisualSvg   String       @db.Text
  variableData    Json         @default("{}")
  status          String       @default("GENERATED")
  publishedUrl    String?
  createdAt       DateTime     @default(now())
  template        PseoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([templateId, createdAt(sort: Desc)])
  @@index([siteId, status])
}


model MutationOperation {
  id                 String   @id @default(cuid())
  siteId             String
  idempotencyKey     String   @unique

  actorId            String
  actorType          String
  authorizedBy       String?
  authPolicyVersion  String?
  authorizedAt       DateTime?

  mutationType       String
  targetModel        String
  targetId           String
  expectedVersion    Int

  mutationPayload    Json
  mutationHash       String

  riskLevel          String
  riskScore          Int
  affectedFields     String[]
  diffSizeBytes      Int      @default(0)

  status             String   @default("PROPOSED")

  executionClaimedBy       String?
  executionClaimedAt       DateTime?
  executionLeaseExpiresAt  DateTime?

  approvedBy         String?
  approvedAt         DateTime?
  approvalExpiresAt  DateTime?
  approvalHash       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  completedAt        DateTime?

  site               Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  snapshot           MutationSnapshot?
  effects            MutationEffect[]
  auditEvents        MutationAuditEvent[]
  proposal           ActionProposal?

  @@index([siteId, status])
  @@index([siteId, targetModel, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([approvalExpiresAt])
}

model MutationSnapshot {
  id              String   @id @default(cuid())
  operationId     String   @unique
  targetModel     String
  targetId        String
  targetVersion   Int
  beforeState     Json
  afterState      Json?
  createdAt       DateTime @default(now())

  operation       MutationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([targetModel, targetId, targetVersion])
  @@index([targetModel, targetId, createdAt(sort: Desc)])
}

model MutationEffect {
  id                 String   @id @default(cuid())
  operationId        String
  idempotencyKey     String   @unique

  effectType         String
  platform           String?
  payload            Json

  status             String   @default("QUEUED")

  confirmationMode   String   @default("POLL")
  compensationPolicy String   @default("IRREVERSIBLE")

  externalId         String?
  externalError      String?

  attempts           Int      @default(0)
  maxAttempts        Int      @default(5)
  nextRetryAt        DateTime?

  dispatchedAt       DateTime?
  confirmedAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  operation          MutationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([status, nextRetryAt])
  @@index([effectType, status])
}

model MutationAuditEvent {
  id            String   @id @default(cuid())
  operationId   String
  eventType     String
  actorId       String
  details       Json?
  createdAt     DateTime @default(now())

  operation     MutationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorId, createdAt(sort: Desc)])
}


model AgentRun {
  id             String         @id @default(cuid())
  siteId         String

  agentType      String
  status         AgentRunStatus @default(QUEUED)

  parentRunId    String?
  parentRun      AgentRun?      @relation("AgentRunHierarchy", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns      AgentRun[]     @relation("AgentRunHierarchy")

  startedAt      DateTime?
  completedAt    DateTime?
  lastHeartbeatAt DateTime?

  itemsProcessed Int            @default(0)
  findingCount   Int            @default(0)

  tokensUsed     Int?
  costUsd        Decimal?

  triggerEvent   String?
  metadata       Json?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  findings       AgentFinding[]

  @@index([siteId, agentType, createdAt(sort: Desc)])
  @@index([siteId, status])
  @@index([parentRunId])
  @@index([status, lastHeartbeatAt])
}

model AgentFinding {
  id             String          @id @default(cuid())
  agentRunId     String

  fingerprint    String

  type           String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)

  title          String
  description    String          @db.Text

  confidence     Float

  resourceType   String?
  resourceId     String?

  recommendation String?         @db.Text

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  agentRun       AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  evidence         FindingEvidence[]
  opportunityLinks OpportunityFinding[]

  @@index([fingerprint])
  @@index([agentRunId])
  @@index([type, severity])
  @@index([status])
  @@index([resourceType, resourceId])
}

model FindingEvidence {
  id          String   @id @default(cuid())
  findingId   String

  sourceType  String
  sourceId    String?

  metric      String?
  value       String?
  metadata    Json?

  observedAt  DateTime @default(now())

  finding     AgentFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([sourceType, sourceId])
}

model OpportunityFinding {
  id              String   @id @default(cuid())

  decisionId      String
  findingId       String

  createdAt       DateTime @default(now())

  decision        GrowthDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  finding         AgentFinding   @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([decisionId, findingId])
  @@index([findingId])
}

model Ga4DailyPerformance {
  id              String   @id @default(cuid())
  siteId          String
  date            String
  landingPage     String

  sessions        Int      @default(0)
  users           Int      @default(0)
  engagedSessions Int      @default(0)
  conversions     Float    @default(0)
  engagementRate  Float?
  pageviews       Int      @default(0)

  fetchedAt       DateTime @default(now())

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date, landingPage])
  @@index([siteId, date(sort: Desc)])
  @@index([siteId, landingPage, date(sort: Desc)])
}


model ActionProposal {
  id                  String    @id @default(cuid())
  siteId              String
  decisionId          String
  operationId         String?   @unique
  idempotencyKey      String    @unique

  previousProposalId  String?
  previousProposal    ActionProposal?  @relation("ProposalRetryChain", fields: [previousProposalId], references: [id])
  retryProposals      ActionProposal[] @relation("ProposalRetryChain")

  actionType          String
  targetUrl           String
  targetModel         String
  targetId            String

  proposedChanges     Json
  expectedOutcome     String    @db.Text

  riskLevel           String
  safetyTier          Int       @default(1)
  confidence          Float

  status              String    @default("DRAFT")

  requiresApproval    Boolean   @default(true)
  approvedBy          String?
  approvedAt          DateTime?
  approvalExpiresAt   DateTime?
  approvalHash        String?

  attemptCount        Int       @default(0)
  maxAttempts         Int       @default(3)
  lastAttemptAt       DateTime?
  lastAttemptError    String?   @db.Text

  verificationCriteria  Json
  verificationUrl       String?
  verifiedAt            DateTime?
  verificationResult    String?
  verificationDetails   Json?

  rolledBackBy        String?
  rolledBackAt        DateTime?
  rollbackReason      String?   @db.Text

  generatedBy         String    @default("system:proposal-generator")

  metadata            Json?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  site                Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  decision            GrowthDecision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  operation           MutationOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([decisionId])
  @@index([decisionId, status])
  @@index([status, createdAt])
  @@index([siteId, actionType])
  @@index([approvalExpiresAt])
  @@index([previousProposalId])
}


model BudgetReservation {
  id          String    @id @default(cuid())
  siteId      String
  operationId String?
  traceId     String?

  status      String    @default("RESERVED")
  reservedAt  DateTime  @default(now())
  consumedAt  DateTime?
  releasedAt  DateTime?
  reason      String?

  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status, reservedAt])
  @@index([siteId, reservedAt])
}

model CircuitBreaker {
  id                    String    @id @default(cuid())
  siteId                String
  channel               String

  state                 String    @default("CLOSED")
  consecutiveFailures   Int       @default(0)
  consecutiveSuccesses  Int       @default(0)
  lastFailureAt         DateTime?
  lastSuccessAt         DateTime?
  openedAt              DateTime?
  nextAttemptAt         DateTime?
  halfOpenProbeInFlight Boolean   @default(false)

  updatedAt             DateTime  @updatedAt

  site                  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, channel])
  @@index([state])
}

model AutonomousExecutionClaim {
  id            String   @id @default(cuid())
  siteId        String
  opportunityId String   @unique
  proposalId    String
  claimedBy     String
  claimedAt     DateTime @default(now())

  generation    Int      @default(1)

  status        String   @default("ACTIVE")
  completedAt   DateTime?
  releasedAt    DateTime?
  releaseReason String?

  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
}

model ExecutionTrace {
  id                  String    @id @default(cuid())
  siteId              String
  parentTraceId       String?

  triggerType          String
  triggerId            String?

  findingId            String?
  findingType          String?

  opportunityId        String
  opportunityScore     Float

  proposalId           String?
  actionType           String
  safetyTier           Int
  riskLevel            String?
  riskScore            Int?

  operatingMode        String
  effectiveTierLimit   Int
  policyDecision       String
  policyReason         String
  budgetReservationId  String?
  circuitBreakerState  String?

  operationId          String?
  attemptNumber        Int      @default(1)
  executionResult      String?
  failureClass         String?
  retryCount           Int      @default(0)

  actorType            String
  actorId              String?

  verificationStatus   String?
  verificationAt       DateTime?
  metricsBaseline      Json?
  metricsAfter         Json?

  discoveredAt         DateTime
  authorizedAt         DateTime?
  executedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
  @@index([opportunityId])
  @@index([operationId])
  @@index([verificationStatus])
  @@index([parentTraceId])
}


model ActionPerformance {
  id                String   @id @default(cuid())
  siteId            String
  actionType        String

  totalExperiments  Int
  wins              Int
  losses            Int
  inconclusive      Int
  aborted           Int
  winRate           Float

  avgPositionDelta  Float?
  avgClicksLift     Float?
  avgCtrLift        Float?
  avgConfidence     Float?

  computedAt        DateTime @default(now())
  computedVersion   String   @default("d6-v1")
  experimentCount   Int

  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, actionType])
  @@index([siteId])
}

model LearnedSignal {
  id                String   @id @default(cuid())
  siteId            String
  signalType        String
  actionType        String

  adjustment        Float
  magnitude         String

  derivedFrom       Int
  winRate           Float
  reason            String

  status            String   @default("PROPOSED")
  version           Int      @default(1)
  activatedAt       DateTime?
  supersededAt      DateTime?
  supersededBy      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)


  @@index([siteId, status])
  @@index([siteId, actionType])
  @@index([siteId, signalType, actionType])
}

model PortfolioAllocation {
  id                 String   @id @default(cuid())
  siteId             String
  opportunityId      String

  cycleId            String
  optimizerVersion   String

  decision           String
  rank               Int?
  utilityScore       Float?

  reasonCodes        Json

  scoreRecordId      String
  evidenceHash       String
  learningVersion    String?

  constraintSnapshot Json
  candidateSnapshot  Json

  experimentPreference String?

  allocatedAt        DateTime    @default(now())
  expiresAt          DateTime

  site               Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  opportunity        GrowthDecision @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([cycleId, opportunityId])
  @@index([siteId, decision, expiresAt])
  @@index([siteId, cycleId])
}
