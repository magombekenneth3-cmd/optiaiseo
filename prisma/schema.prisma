  siteId      String
  url         String
  keyword     String
  date        String // YYYY-MM-DD (string for composite index efficiency)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  device      String   @default("ALL") // ALL, DESKTOP, MOBILE, TABLET
  fetchedAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, keyword, date, device])
  @@index([siteId, date(sort: Desc)])
  @@index([siteId, url, date(sort: Desc)])
  @@index([siteId, keyword, date(sort: Desc)])
}

model PseoTemplate {
  id        String     @id @default(cuid())
  siteId    String
  name      String
  pattern   String
  dataset   Json
  status    String     @default("DRAFT")
  pageCount Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages     PseoPage[]

  @@index([siteId, createdAt(sort: Desc)])
}

model PseoPage {
  id              String       @id @default(cuid())
  templateId      String
  siteId          String
  slug            String
  title           String
  metaDescription String?
  contentHtml     String       @db.Text
  schemaJsonLd    Json         @default("[]")
  heroVisualSvg   String       @db.Text
  variableData    Json         @default("{}")
  status          String       @default("GENERATED")
  publishedUrl    String?
  createdAt       DateTime     @default(now())
  template        PseoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([templateId, createdAt(sort: Desc)])
  @@index([siteId, status])
}

// ── MUTATION OPERATION LIFECYCLE ──────────────────────────────────────────────
// Central abstraction for ALL mutations in the system.
// See: implementation_plan.md v2.1
// ─────────────────────────────────────────────────────────────────────────────

model MutationOperation {
  id                 String   @id @default(cuid())
  siteId             String
  idempotencyKey     String   @unique

  // Actor + Authorization snapshot
  actorId            String   // userId or "system:inngest" or "system:cron"
  actorType          String   // "USER" | "SYSTEM" | "CRON"
  authorizedBy       String?  // policy or userId that granted permission
  authPolicyVersion  String?  // e.g. "rbac-v3" — auditable: "why was this allowed?"
  authorizedAt       DateTime?

  // What
  mutationType       String   // "BLOG_CONTENT_UPDATE" | "CMS_PUBLISH" | "GITHUB_PR" | ...
  targetModel        String   // "Blog" | "Site" | "InternalLink"
  targetId           String   // e.g. blog.id
  expectedVersion    Int      // optimistic concurrency: version we expect on target

  // Canonical mutation
  mutationPayload    Json     // The exact executable mutation (patch object)
  mutationHash       String   // SHA-256 of canonicalized mutationPayload

  // Risk
  riskLevel          String   // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  riskScore          Int      // 0-100
  affectedFields     String[] // ["content", "schemaMarkup"]
  diffSizeBytes      Int      @default(0)

  // Lifecycle
  // PROPOSED → PENDING_APPROVAL → APPROVED → EXECUTING → COMMITTED → EFFECTS_PENDING → COMPLETED
  // Terminal: REJECTED | EXPIRED | CANCELLED | FAILED | STALE | COMPLETED_WITH_ERRORS
  status             String   @default("PROPOSED")

  // Execution claim (prevents two workers executing the same operation)
  executionClaimedBy       String?   // worker/process ID that claimed execution
  executionClaimedAt       DateTime?
  executionLeaseExpiresAt  DateTime? // lease expires → another worker can reclaim

  // Approval (populated when status reaches APPROVED)
  approvedBy         String?
  approvedAt         DateTime?
  approvalExpiresAt  DateTime?
  approvalHash       String?  // SHA-256 of canonical mutation AT approval time

  // Metadata
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  completedAt        DateTime?

  // Relations — onDelete: Restrict prevents cascade-destroying audit history
  site               Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  snapshot           MutationSnapshot?
  effects            MutationEffect[]
  auditEvents        MutationAuditEvent[]
  proposal           ActionProposal?

  @@index([siteId, status])
  @@index([siteId, targetModel, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([approvalExpiresAt])
}

model MutationSnapshot {
  id              String   @id @default(cuid())
  operationId     String   @unique
  targetModel     String   // "Blog"
  targetId        String   // e.g. blog.id
  targetVersion   Int      // version AT snapshot time (before mutation)
  beforeState     Json     // full state before mutation
  afterState      Json?    // full state after (null until COMMITTED)
  createdAt       DateTime @default(now())

  // Cascade from operation only (operation itself uses Restrict from Site)
  operation       MutationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([targetModel, targetId, targetVersion])
  @@index([targetModel, targetId, createdAt(sort: Desc)])
}

model MutationEffect {
  id                 String   @id @default(cuid())
  operationId        String
  idempotencyKey     String   @unique

  // What
  effectType         String   // "CMS_PUBLISH" | "INDEXNOW" | "GITHUB_PR" | "GOOGLE_INDEXING"
  platform           String?  // "WORDPRESS" | "GHOST" | "SHOPIFY" | ... (for CMS effects)
  payload            Json     // platform-specific parameters

  // Lifecycle
  // QUEUED → DISPATCHED → CONFIRMED | FAILED | IRREVERSIBLE_DISPATCHED
  // QUEUED → CANCELLED
  status             String   @default("QUEUED")

  // Confirmation strategy
  confirmationMode   String   @default("POLL")        // "POLL" | "READ_AFTER_WRITE" | "NONE"
  compensationPolicy String   @default("IRREVERSIBLE") // "ROLLBACK_SUPPORTED" | "ROLLBACK_PARTIAL" | "COMPENSATION_ONLY" | "IRREVERSIBLE"

  // External tracking
  externalId         String?  // WordPress post ID, GitHub PR URL, etc.
  externalError      String?

  // Retry
  attempts           Int      @default(0)
  maxAttempts        Int      @default(5)
  nextRetryAt        DateTime?

  // Timestamps
  dispatchedAt       DateTime?
  confirmedAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  operation          MutationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([status, nextRetryAt])
  @@index([effectType, status])
}

model MutationAuditEvent {
  id            String   @id @default(cuid())
  operationId   String
  eventType     String   // "CREATED" | "RISK_ASSESSED" | "APPROVAL_REQUESTED" |
                         // "APPROVED" | "REJECTED" | "EXECUTING" | "COMMITTED" |
                         // "EFFECT_DISPATCHED" | "EFFECT_CONFIRMED" | "STALE" |
                         // "FAILED" | "ROLLED_BACK" | "COMPLETED_WITH_ERRORS"
  actorId       String   // who triggered this event
  details       Json?    // event-specific metadata
  createdAt     DateTime @default(now())

  // Append-only: no UPDATE or DELETE operations exposed through mutation library
  operation     MutationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorId, createdAt(sort: Desc)])
}

// ── PHASE A: AGENT OPERATING SYSTEM ──────────────────────────────────────────
// Core infrastructure for the Agentic SEO Operating System.
// Agents observe → produce Findings → backed by Evidence → feed Opportunities.
// ─────────────────────────────────────────────────────────────────────────────

model AgentRun {
  id             String         @id @default(cuid())
  siteId         String

  agentType      String         // "DISCOVERY" | "CRAWL" | "TECHNICAL_SEO" | ...
  status         AgentRunStatus @default(QUEUED)

  // Explicit parent/child hierarchy for orchestrator → agent relationships
  parentRunId    String?
  parentRun      AgentRun?      @relation("AgentRunHierarchy", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns      AgentRun[]     @relation("AgentRunHierarchy")

  startedAt      DateTime?
  completedAt    DateTime?
  lastHeartbeatAt DateTime?  // Updated by lease heartbeat; used for stale-run detection

  itemsProcessed Int            @default(0)
  findingCount   Int            @default(0)

  tokensUsed     Int?
  costUsd        Decimal?

  triggerEvent   String?        // Inngest event name that triggered this run
  metadata       Json?          // Input snapshot, configuration, etc.

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  findings       AgentFinding[]

  @@index([siteId, agentType, createdAt(sort: Desc)])
  @@index([siteId, status])
  @@index([parentRunId])
  @@index([status, lastHeartbeatAt])
}

model AgentFinding {
  id             String          @id @default(cuid())
  agentRunId     String

  // Stable identity of the underlying issue.
  // sha256(siteId:type:resourceType:resourceId)
  fingerprint    String

  type           String          // "MISSING_META_DESCRIPTION", "QUICK_WIN", etc.
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)

  title          String
  description    String          @db.Text

  // 0.0–1.0
  confidence     Float

  resourceType   String?         // "SITE" | "PAGE" | "QUERY" | "KEYWORD"
  resourceId     String?         // URL, query text, keyword, etc.

  recommendation String?         @db.Text

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  agentRun       AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  evidence         FindingEvidence[]
  opportunityLinks OpportunityFinding[]

  @@index([fingerprint])
  @@index([agentRunId])
  @@index([type, severity])
  @@index([status])
  @@index([resourceType, resourceId])
}

model FindingEvidence {
  id          String   @id @default(cuid())
  findingId   String

  sourceType  String          // "GSC" | "GA4" | "CRAWL" | "SITEMAP" | "ROBOTS" | "COMPUTED"
  sourceId    String?         // crawlRunId, query/page/date composite, etc.

  metric      String?         // "position" | "httpStatus" | "ctr" | ...
  value       String?         // String representation
  metadata    Json?           // Structured data for complex evidence

  observedAt  DateTime @default(now())  // Provenance timestamp

  finding     AgentFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([sourceType, sourceId])
}

// Join table: links GrowthDecision (Opportunities) to their source Findings.
// Enables explainability: "Why did OptiAISEO generate this recommendation?"
model OpportunityFinding {
  id              String   @id @default(cuid())

  decisionId      String
  findingId       String

  createdAt       DateTime @default(now())

  decision        GrowthDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  finding         AgentFinding   @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([decisionId, findingId])
  @@index([findingId])
}

model Ga4DailyPerformance {
  id              String   @id @default(cuid())
  siteId          String
  date            String   // YYYY-MM-DD (matches GscDailyPerformance convention)
  landingPage     String

  sessions        Int      @default(0)
  users           Int      @default(0)
  engagedSessions Int      @default(0)
  conversions     Float    @default(0)
  engagementRate  Float?
  pageviews       Int      @default(0)

  fetchedAt       DateTime @default(now())

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date, landingPage])
  @@index([siteId, date(sort: Desc)])
  @@index([siteId, landingPage, date(sort: Desc)])
}

// ── PHASE B: ACTION PROPOSALS ─────────────────────────────────────────────────
// Bridge between intelligence (Phase A) and execution (Phase B).
// An ActionProposal captures exactly what will change, why, and how to verify.

model ActionProposal {
  id                  String    @id @default(cuid())
  siteId              String
  decisionId          String
  operationId         String?   @unique
  idempotencyKey      String    @unique

  // Retry lineage: if this proposal is a retry, points to the predecessor
  previousProposalId  String?
  previousProposal    ActionProposal?  @relation("ProposalRetryChain", fields: [previousProposalId], references: [id])
  retryProposals      ActionProposal[] @relation("ProposalRetryChain")

  // What
  actionType          String    // ActionType enum from types.ts
  targetUrl           String
  targetModel         String    // "Blog" | "Page" | "Site"
  targetId            String

  // The proposed change
  proposedChanges     Json      // ProposedChange[]
  expectedOutcome     String    @db.Text

  // Risk & Confidence
  riskLevel           String    // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  safetyTier          Int       @default(1) // 1 | 2 | 3
  confidence          Float

  // Lifecycle
  status              String    @default("DRAFT")
  // DRAFT → READY → APPROVED → EXECUTING → EXECUTED → VERIFYING → VERIFIED
  // VERIFIED → ROLLED_BACK (post-verification regression rollback)
  // Terminal: REJECTED | FAILED | EXPIRED | ROLLED_BACK

  // Approval
  requiresApproval    Boolean   @default(true)
  approvedBy          String?
  approvedAt          DateTime?
  approvalExpiresAt   DateTime?
  approvalHash        String?   // SHA-256 of proposedChanges at approval time

  // Execution Attempts
  attemptCount        Int       @default(0)
  maxAttempts         Int       @default(3)
  lastAttemptAt       DateTime?
  lastAttemptError    String?   @db.Text

  // Verification
  verificationCriteria  Json    // VerificationCriterion[]
  verificationUrl       String? // If different from targetUrl (e.g. CMS external URL)
  verifiedAt            DateTime?
  verificationResult    String? // "VERIFIED" | "FAILED" | "PARTIAL"
  verificationDetails   Json?   // VerificationDetail[]

  // Rollback
  rolledBackBy        String?   // userId or "system" that initiated rollback
  rolledBackAt        DateTime?
  rollbackReason      String?   @db.Text

  // Authorization
  generatedBy         String    @default("system:proposal-generator")

  // Extensible metadata (D.4 LLM audit envelope, etc.)
  metadata            Json?

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  // Relations
  site                Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  decision            GrowthDecision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  operation           MutationOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([decisionId])
  @@index([decisionId, status])
  @@index([status, createdAt])
  @@index([siteId, actionType])
  @@index([approvalExpiresAt])
  @@index([previousProposalId])
}


// ═══════════════════════════════════════════════════════════════════════════════
// Phase C — Autonomous Execution Infrastructure
// ═══════════════════════════════════════════════════════════════════════════════

/// Atomic budget reservation for daily mutation limits (rolling 24h window).
/// Usage is derived from reservation records, NOT from mutable counters.
model BudgetReservation {
  id          String    @id @default(cuid())
  siteId      String
  operationId String?   // Linked after execution starts
  traceId     String?   // Link to ExecutionTrace

  // Lifecycle: RESERVED → CONSUMED | RELEASED
  status      String    @default("RESERVED")
  reservedAt  DateTime  @default(now())
  consumedAt  DateTime?
  releasedAt  DateTime?
  reason      String?   // Why released (failure, timeout, budget reclaim)

  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status, reservedAt])
  @@index([siteId, reservedAt])
}

/// Durable circuit breaker state per site+channel.
/// Prevents cascading failures from shutting down unrelated channels.
model CircuitBreaker {
  id                    String    @id @default(cuid())
  siteId                String
  channel               String    // "wordpress" | "github" | "gsc" | "indexnow"

  // State machine: CLOSED → OPEN → HALF_OPEN → CLOSED
  state                 String    @default("CLOSED")
  consecutiveFailures   Int       @default(0)
  consecutiveSuccesses  Int       @default(0)  // Tracked in HALF_OPEN
  lastFailureAt         DateTime?
  lastSuccessAt         DateTime?
  openedAt              DateTime?
  nextAttemptAt         DateTime? // When HALF_OPEN probe is allowed
  halfOpenProbeInFlight Boolean   @default(false) // Only ONE worker can probe

  updatedAt             DateTime  @updatedAt

  site                  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, channel])
  @@index([state])
}

/// Idempotent execution claim — prevents duplicate autonomous executions
/// for the same opportunity. Enforced at the database level.
model AutonomousExecutionClaim {
  id            String   @id @default(cuid())
  siteId        String
  opportunityId String   @unique  // ONE row per opportunity — upsert semantics
  proposalId    String
  claimedBy     String   // Worker/process ID
  claimedAt     DateTime @default(now())

  // Monotonic fencing token. Incremented on each re-acquisition.
  // Authorization carries the generation; the Phase B boundary verifies it.
  // After stale recovery: Worker A (gen=1) cannot cross the boundary
  // once Worker B reclaims (gen=2).
  generation    Int      @default(1)

  // Lifecycle: ACTIVE → COMPLETED | RELEASED (then back to ACTIVE on reclaim)
  status        String   @default("ACTIVE")
  completedAt   DateTime?
  releasedAt    DateTime?
  releaseReason String?

  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
}

/// Immutable execution trace — complete audit trail from discovery to outcome.
/// Append-only after the authorization stage.
model ExecutionTrace {
  id                  String    @id @default(cuid())
  siteId              String
  parentTraceId       String?   // For retries linked to original

  // Trigger
  triggerType          String   // "CRON" | "EVENT" | "MANUAL"
  triggerId            String?  // Inngest event ID or cron run ID

  // Discovery
  findingId            String?
  findingType          String?

  // Decision
  opportunityId        String
  opportunityScore     Float

  // Proposal
  proposalId           String?
  actionType           String
  safetyTier           Int
  riskLevel            String?
  riskScore            Int?

  // Authorization
  operatingMode        String
  effectiveTierLimit   Int
  policyDecision       String   // "AUTO_EXECUTE" | "NEEDS_APPROVAL" | "BLOCKED"
  policyReason         String
  budgetReservationId  String?
  circuitBreakerState  String?  // "CLOSED" | "OPEN" | "HALF_OPEN"

  // Execution
  operationId          String?
  attemptNumber        Int      @default(1)
  executionResult      String?  // "SUCCESS" | "FAILED" | "ROLLED_BACK"
  failureClass         String?  // From failure classifier
  retryCount           Int      @default(0)

  // Actor
  actorType            String   // "SYSTEM" | "USER" | "APPROVAL"
  actorId              String?

  // Verification (populated later by verifier — append-only)
  verificationStatus   String?  // "PENDING" | "INSUFFICIENT_DATA" | "IMPROVED" | "UNCHANGED" | "DEGRADED" | "INCONCLUSIVE"
  verificationAt       DateTime?
  metricsBaseline      Json?
  metricsAfter         Json?

  // Timestamps (immutable after creation)
  discoveredAt         DateTime
  authorizedAt         DateTime?
  executedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
  @@index([opportunityId])
  @@index([operationId])
  @@index([verificationStatus])
  @@index([parentTraceId])
}
